        {
          "name": "Crear especialidad PROGRAMMING",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const dia = (n) => { const d = new Date(); d.setDate(d.getDate() + n); return d.toISOString().slice(0, 10); };",
                  "pm.collectionVariables.set(\"run\", String(Date.now()).slice(-7));",
                  "pm.collectionVariables.set(\"inicio\", dia(30));",
                  "pm.collectionVariables.set(\"fin\", dia(60));",
                  "pm.collectionVariables.set(\"ayer\", dia(-1));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"espProg\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/specialties",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "specialties"
              ]
