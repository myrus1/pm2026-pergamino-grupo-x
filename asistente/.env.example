# Solo nombres de variables. No subir claves reales: el .env no se versiona.

# Clave de Groq (gratis en https://console.groq.com). Se usa para transcribir el audio.
GROQ_API_KEY=

# Modelo que decide qué herramientas usar (API compatible con OpenAI).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Si queda vacía se usa GROQ_API_KEY.
LLM_API_KEY=

# URL del backend Spring Boot.
BACKEND_URL=http://localhost:8080

# Orígenes del front autorizados por CORS (lista separada por comas).
ALLOWED_ORIGINS=http://localhost:5173

# Puerto: no lo fijes. Railway lo define solo y, si falta, se usa 8000.
# PORT=8000
